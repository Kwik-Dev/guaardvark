 # ═══════════════════════════════════════════════════════════════════════════════
   # Guaardvark — sample environment for the `cloud-plus` branch
   #
   #   cp .env.cloud .env
   #
   # Every value below is a PLACEHOLDER: replace anything shaped like `your-...`,
   # `change-me`, `/path/to/...` or `*.example` before you run it. `.env` is
   # gitignored; THIS file is committed — so never put a real credential, a real
   # hostname or an absolute home path in it. It is reviewed by
   # scripts/check_portable.sh before it lands.
   #
   # Per-variable reference: CLOUD_PLUS_FEATURES.md §10, and docs/MACOS.md for the
   # RTX-on-Mac memory strategy this branch is built around.
   # ═══════════════════════════════════════════════════════════════════════════════


   # ── 1. Core / runtime ─────────────────────────────────────────────────────────
   # Everything here has a working default for a single-machine install except
   # SECRET_KEY, which must be set to something random.

   SECRET_KEY=change-me-to-a-random-string
   # GUAARDVARK_ROOT=/path/to/guaardvark-checkout
   # DATABASE_URL=postgresql://guaardvark:guaardvark@localhost:5432/guaardvark
   # REDIS_URL=redis://localhost:6379/0
   # FLASK_PORT=5055
   # VITE_PORT=5173


   # ── 2. Cloud chat — what this branch is for ───────────────────────────────────
   # One OpenAI-compatible client covers all of these; only the base URL changes:
   #
   #   https://api.openai.com/v1          OpenAI
   #   https://openrouter.ai/api/v1       OpenRouter
   #   https://api.groq.com/openai/v1     Groq
   #   https://ollama.com/v1              Ollama Cloud (what this branch runs on)
   #   http://127.0.0.1:8000/v1           a local vLLM / llama.cpp server
   #
   # GUAARDVARK_OPENAI_BASE_URL is REQUIRED — there is deliberately no implicit
   # api.openai.com default. The key is optional (a local server and Ollama need
   # none), so a bare key exported for some other tool can never route a call
   # off-box on its own.

   GUAARDVARK_OPENAI_BASE_URL=https://your-endpoint.example/v1
   GUAARDVARK_OPENAI_API_KEY=your-api-key
   # Model used when nothing has been chosen in Settings. Unlike the consent pair
   # below, this is a FALLBACK: the Settings selection wins over it.
   GUAARDVARK_OPENAI_MODEL=gpt-4o-mini
   # GUAARDVARK_OPENAI_TIMEOUT=120

   # Consent, and which provider that consent applies to.
   #
   # The base URL above is only CAPABILITY. These two are the consent. Leave them
   # unset and the Settings page toggles decide — a fresh install is fully local
   # until someone opts in. Set them here and they pin the deployment: the
   # environment wins over the stored DB rows, so the box stays cloud across a DB
   # reset, and provider_state() reports the toggle as env-forced so Settings shows
   # it as pinned instead of offering a switch the gate would ignore.

   GUAARDVARK_CLOUD_MODELS_ENABLED=true
   GUAARDVARK_LLM_PROVIDER=openai

   # Optional second provider (multi-provider escalation). Selecting it needs
   # GUAARDVARK_LLM_PROVIDER=mistral.
   # MISTRAL_API_KEY=your-mistral-api-key
   # GUAARDVARK_MISTRAL_BASE_URL=https://api.mistral.ai/v1
   # GUAARDVARK_MISTRAL_MODEL=mistral-large-latest
   # GUAARDVARK_MISTRAL_TIMEOUT=120


   # ── 3. Memory strategy — why chat belongs in the cloud here ───────────────────
   # The point of §2: a local chat model of ~16 GB cannot coexist with the offline
   # image families (Z-Image declares a 21 GB footprint) on a 48 GB box. Keeping the
   # chat brain remote is what frees that budget. These gates are the backstop for
   # whenever a local model IS resident anyway.

   # Swap hard block. macOS holds swap "sticky" — it does not come back promptly
   # after the pressure is gone — so the 8 GB default can refuse legitimate work on
   # a healthy Mac. Raise it; swap is still ignored when judging RAM headroom.
   GUAARDVARK_SWAP_HARD_MAX_GB=16

   # Hard RAM floor, overriding the default min(6 GB, 10% of total RAM). Only worth
   # setting on a box shared with other work that needs the headroom guaranteed.
   # GUAARDVARK_RAM_HARD_MIN_GB=8

   # How long a model stays resident. On an accelerator a short TTL lets an eviction
   # actually stick; on a CPU-only box "resident" (-1) avoids reloading from disk.
   # GUAARDVARK_CHAT_KEEP_ALIVE_GPU=15m
   # GUAARDVARK_CHAT_KEEP_ALIVE_CPU=-1
   # GUAARDVARK_EMBED_KEEP_ALIVE_GPU=5m
   # GUAARDVARK_EMBED_KEEP_ALIVE_CPU=-1


   # ── 4. Apple Silicon / ComfyUI ────────────────────────────────────────────────
   # Z-Image's offline path is CUDA-only, so on MPS it has to render through
   # ComfyUI. Both of these are opt-in.
   # GUAARDVARK_ZIMAGE_USE_COMFYUI=1

   # Share one model tree with ComfyUI Desktop instead of keeping a second copy. A
   # `~/...` value is expanded; the model registry AND the ComfyUI downloader read
   # <dir>/models, so models you already have show up as installed instead of as
   # "missing".
   # GUAARDVARK_COMFYUI_DIR=~/ComfyUI-Shared
   # GUAARDVARK_COMFYUI_URL=http://127.0.0.1:8188


   # ── 5. Local Ollama — the fallback, not the chat brain ────────────────────────
   # Embeddings always stay on Ollama whatever the chat provider is, so the RAG
   # vector store stays consistent with whatever indexed it. Vision analysis and the
   # local prompt/chat fallbacks read it too.
   # OLLAMA_BASE_URL=http://127.0.0.1:11434

   # Bearer token for a remote or cloud Ollama endpoint. Read by the `ollama` client
   # library — not by Guaardvark's raw-HTTP vision path.
   # OLLAMA_API_KEY=your-ollama-api-key

   # Embedding model for RAG. Overrides the installed-model probe; the Settings
   # selection still wins over it.
   # GUAARDVARK_EMBEDDING_MODEL=nomic-embed-text


   # ── 6. Prompt rewriting ───────────────────────────────────────────────────────
   # Send your exact words to the image/video model: skips the director-LLM rewrite,
   # the offline style stuffing, and the word-budget clip. Handy for a demo, and for
   # proving a generation makes no model call beyond the render itself.
   # VERBATIM_PROMPTS=1